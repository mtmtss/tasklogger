{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TaskLogger",
  "version": "0.1.0",
  "identifier": "com.tasklogger.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TaskLogger",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 600
      },
      {
        "label": "float",
        "title": "TaskLogger Float",
        "width": 340,
        "height": 92,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "transparent": true,
        "shadow": false,
        "visible": false
      },
      {
        "label": "capture",
        "title": "TaskLogger Capture",
        "width": 520,
        "height": 180,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
